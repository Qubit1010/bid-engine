# Copy to backend/.env and fill in. Both keys are OPTIONAL for the demo:
# the repo ships with a warmed LLM cache for the three demo-assets RFPs,
# so the full pipeline replays offline with no keys at all.
# Keys are only needed to process NEW documents.

# Primary provider (extraction, matching, drafting)
OPENAI_API_KEY=sk-...

# Fallback provider (auto-retry if OpenAI fails)
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides
# OPENAI_MODEL=gpt-5.2
# CLAUDE_MODEL=claude-sonnet-4-6

# Demo pacing: floors each pipeline step's wall time (seconds) so the live
# stepper stays followable when responses replay from cache. 0 = off.
# Set ~1.5 for stage demos. Never slows genuinely fresh runs.
# DEMO_MIN_STEP_SECONDS=1.5
