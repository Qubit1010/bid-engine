# --- secrets (never commit) ---
.env
backend/.env

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- runtime state (regenerated locally) ---
backend/bidsense.db
backend/uploads/

# NOTE: backend/cache/ and backend/models/ ARE committed on purpose.
# The cache holds the LLM responses for the three demo RFPs, so a cold
# clone replays the full pipeline offline with no API keys — that's the
# venue-resilience feature, not an accident.

# --- node / next ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
*.tsbuildinfo

# --- editor / os ---
.DS_Store
Thumbs.db
~$*.docx
